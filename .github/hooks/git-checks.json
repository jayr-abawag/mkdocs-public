{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/git-checks.cjs session-start",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/git-checks.cjs pre-tool-use",
        "timeoutSec": 10
      }
    ]
  }
}
